{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FastAPI: iniciar con recarga",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "uvicorn",
                "src.main:app",
                "--reload",
                "--reload-dir",
                "src",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}
