{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: depurar con recarga",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.main:app",
                "--reload",
                "--reload-dir",
                "src",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        }
    ]
}
