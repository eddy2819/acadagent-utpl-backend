# PostgreSQL
POSTGRES_DB=acadagent
POSTGRES_USER=acadagent
POSTGRES_PASSWORD=REEMPLAZAR_CLAVE_POSTGRES
POSTGRES_HOST_PORT=5433

# Conexiones desde Windows
DATABASE_URL=postgresql+psycopg://acadagent:REEMPLAZAR_CLAVE_POSTGRES@localhost:5433/acadagent
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=http://localhost:8001
OLLAMA_URL=http://localhost:11434
MINIO_ENDPOINT=localhost:9000

# Conexiones desde el contenedor del backend
DOCKER_DATABASE_URL=postgresql+psycopg://acadagent:REEMPLAZAR_CLAVE_POSTGRES@postgres:5432/acadagent
DOCKER_REDIS_URL=redis://redis:6379/0
DOCKER_CHROMA_URL=http://chroma:8000
DOCKER_OLLAMA_URL=http://ollama:11434
DOCKER_MINIO_ENDPOINT=minio:9000

# Almacenamiento de documentos
MINIO_ROOT_USER=acadagent_admin
MINIO_ROOT_PASSWORD=REEMPLAZAR_CLAVE_MINIO
MINIO_BUCKET=expedientes
MINIO_SECURE=false

# Modelos locales
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
